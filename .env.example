# Set these in Railway Variables. Never commit real values.

# Railway PostgreSQL (pgvector template) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Claude API key from platform.claude.com
ANTHROPIC_API_KEY=""

# Voyage AI key for document search. Without it only text search works.
VOYAGE_API_KEY=""

# Shared code users enter on first visit. The app stays locked until it is set.
APP_ACCESS_CODE=""

# Maximum user messages per UTC day across all users
DAILY_MESSAGE_LIMIT="200"
